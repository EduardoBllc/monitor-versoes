# Desenvolvimento/testes — projeto, porta e volume Docker separados da produção
COMPOSE_PROJECT_NAME=monitor-versoes-development
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_NAME=monitor_versoes_development
DATABASE_USER=motor_development
DATABASE_PASSWORD=motor_development

# Integrações externas ficam desligadas nos testes
TICKIO_BASE_URL=
TICKIO_USER=
TICKIO_PASSWORD=
BITBUCKET_TOKEN=
BITBUCKET_EMAIL=

# Worktrees mantidas em disco entre operacoes (vazio = default 3, 0 = descarta
# a cada run). Vazio aqui de proposito: a suite carrega este arquivo na coleta,
# e um valor fixo faria teste de main() depender dele.
WORKTREES_MANTIDAS=

PROJECTS_DIR=
