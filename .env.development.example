# Desenvolvimento (`motor --env development`): estado num arquivo separado do de
# produção. A suíte de testes não lê este arquivo; cada teste usa o próprio
# SQLite em tmp_path.
DATABASE_SQLITE_PATH=~/.local/share/monitor-versoes/estado-development.db

# Integrações externas desligadas no desenvolvimento
BITBUCKET_TOKEN=
BITBUCKET_EMAIL=

# Worktrees mantidas em disco entre operações (vazio = default 3, 0 = descarta
# a cada run).
WORKTREES_MANTIDAS=
