          "erro"
        ],
        "title": "Avaliacao"
      },
      "ChamadoConsultado": {
        "properties": {
          "chamado": {
            "type": "string",
            "title": "Chamado"
          },
          "estado": {
            "type": "string",
            "title": "Estado"
          },
          "commits": {
            "items": {
              "$ref": "#/components/schemas/CommitRef"
            },
            "type": "array",
            "title": "Commits"
          }
        },
        "type": "object",
        "required": [
          "chamado",
          "estado",
          "commits"
        ],
        "title": "ChamadoConsultado"
      },
      "CommitRef": {
        "properties": {
          "hash_origem": {
            "type": "string",
            "title": "Hash Origem",
            "default": ""
          },
          "parent": {
            "type": "string",
            "title": "Parent",
            "default": ""
          },
          "chamado": {
            "type": "string",
            "title": "Chamado",
            "default": ""
          },
          "commit_date": {
            "type": "string",
            "format": "date-time",
            "title": "Commit Date",
            "default": "0001-01-01T00:00:00Z"
          },
          "msg": {
            "type": "string",
            "title": "Msg",
            "default": ""
          }
        },
        "type": "object",
        "title": "CommitRef"
      },
